text=Dir[\"#{base}/manuscript/chapter-*.md\"].sort.map{|f|File.read(f)}.join(\" \").downcase.gsub(/["'^a-z0-9]+/," ").strip
patterns=File.readlines("#{base}/protected-patterns.txt",chomp:true).reject{|x|x.strip.empty?||x.start_with?("#")}
failures=[]
patterns.each_with_index do |p,i|
  re=Regexp.new(p)
  n=text.scan(re).length
  failures << [i+1,n,p] unless n==1
end
puts "patterns=#{patterns.length} failures=#{failures.length}"
failures.each{|row|puts row.join(" | ")}
