/bin/zsh -lc "sed -n '553,626p' editions/monroe-1.3/book-06-the-compacts-hand/BOOK_MAP.md && sed -n '1,120p' editions/monroe-1.3/book-06-the-compacts-hand/protected-patterns.txt" in /Users/drive/fractured-path-monroe13
