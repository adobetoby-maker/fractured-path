/bin/zsh -lc "ruby -e '
files=Dir[\"editions/monroe-1.3/book-06-the-compacts-hand/manuscript/chapter-*.md\"].sort
oddq=[]; oddstar=[]; long=[]; badbreak=[]; trailing=[]
files.each do |f|
  lines=File.readlines(f,chomp:true)
  lines.each_with_index{|ln,i| trailing << [File.basename(f),i+1] if ln =~ /[ \\t]+"'$/ }
  lines.each_with_index do |ln,i|
    next unless ln=="---"
    badbreak << [File.basename(f),i+1] unless i>0 && i+1<lines.length && lines[i-1].empty? && lines[i+1].empty?
  end
  start=0; acc=[]
  flush=lambda do
    unless acc.empty?
      raw=acc.join(" ")
      flat=raw.gsub("*","").gsub(/'"\\s+/,\" \").strip
      oddq << [File.basename(f),start,raw] if raw.count(%q{\"}).odd?
      oddstar << [File.basename(f),start,raw] if raw.count(\"*\").odd?
      long << [File.basename(f),start,flat.length,flat[0,72]] if flat.length>700
    end
    acc=[]
  end
  lines.each_with_index do |ln,i|
    if ln.empty?
      flush.call
    else
      start=i+1 if acc.empty?
      acc << ln
    end
  end
  flush.call
end
puts \"FILES=#{files.length} ODDQ=#{oddq.length} ODDSTAR=#{oddstar.length} LONG=#{long.length} BADBREAK=#{badbreak.length} TRAILING=#{trailing.length}\"
puts \"ODDQ\"; oddq.each{|x| puts x[0,2].join(\":\")+\" | \"+x[2][0,120]}
puts \"TRAILING\"; trailing.each{|x| puts x.join(\":\")}
puts \"LONG\"; long.each{|x| puts \"%s:%d | %d | %s…\" % x}
