            rows.append((p.stem.replace('chapter-','ch'),len(flat),op))
print(len(rows))
print('| Chapter | Characters | Opens |')
print('|---|---:|---|')
for ch,n,op in rows:
    print(f'| {ch} | {n} | {op.replace(\"|\",\"\\\\|\")} |')
