/bin/zsh -lc "printf '%s\\n' '--- book 5 opening candidates ---'; rg -n \"six confirmed|six things|Wind|Lira|Iron|Seln|landing beat|Copper Crown|fragment\" books/book-05-* editions/monroe-1.3/book-05-* 2>/dev/null | head -120; printf '%s\\n' '--- exact protected/withheld probes in M4 ---'; rg -n -F -e 'The conditions are met. If you directed it, I believe it would complete.' -e \"That's not a demonstration you're stealing. That's a weapon you're learning.\" -e \"Last year's me was afraid of not-knowing what I do. This year's version is worse: knowing exactly, and deciding anyway. Write it down before, not after. That's the whole difference between me and the system.\" -e \"An instrument doesn't change sides. It changes readings.\" -e 'He does the thing he practised the longest.' -e 'THE CORE MUST BE FREE BEFORE DECLARATION. CHECK THE PIN.' -e 'Enrollee (assay provision) present at bay edge; moved to intervene; received the release on a guard arm; no injury reported. Third-year not struck.' -e 'Response consistent with documented baseline.' -e 'You gave me a false first exchange.' -e 'I gave you a true one. You just assumed it was all of them.' -e \"So win it. Win the crown. Then make them *look* at you. It's the looking that matters — it was always the looking. The crown's just how you force it.\" -e \"Six weeks. I'll see you in the final.\" -e 'He filed the report. Then he sat for a while with the file drawer open, not filing anything else.' editions/monroe-1.3/book-04-copper-crown/manuscript/chapter-{22..29}.md; printf '%s\\n' '--- reserved probes ---'; rg -n -i '\\[UNBOUND\\]|tide-adjacent|Quieting|Architect|Level 4|decision point|colder country|case' editions/monroe-1.3/book-04-copper-crown/manuscript/chapter-{22..29}.md || true" in /Users/drive/fractured-path-monroe13
