/bin/zsh -lc "python3 - <<'PY'
import re, difflib, pathlib
srcs=[pathlib.Path(f'books/book-07-void-roads/chapters/chapter-{i:02}.md') for i in range(5,8)]
ms=[pathlib.Path(f'editions/monroe-1.3/book-07-void-roads/manuscript/chapter-{i:02}.md') for i in range(15,23)]
stop=set('a an the and or but of to in on at for from with as is was were be been being it its he she they them his her their this that then there had have has did do does not no so if by into out up down over under before after when where which who what i you we my your our'.split())
def units(path):
 out=[]
 for ln,line in enumerate(path.read_text().splitlines(),1):
  if not line.strip() or line.startswith('#') or line.strip()=='---': continue
  toks=re.findall(r\"[a-z]+\",line.lower());
  if len(toks)>=5: out.append((ln,line.strip(),toks))
 return out
S=[(p.name,)+u for p in srcs for u in units(p)]
M=[(p.name,)+u for p in ms for u in units(p)]
rows=[]
for mf,ml,mt,mtok in M:
 mc=[x for x in mtok if x not in stop]
 for sf,sl,st,stok in S:
  sc=[x for x in stok if x not in stop]
  jac=len(set(mc)&set(sc))/max(1,len(set(mc)|set(sc)))
  seq=difflib.SequenceMatcher(None,mc,sc).ratio()
  score=.55*seq+.45*jac
