   167	def status(book):
   168	    for f in sorted(ED.joinpath(book, "manuscript").glob("chapter-*.md")):
   169	        n = int(f.stem.split("-")[1]); d = chdir(book, n)
   170	        st = [x for x in ("raw_segs.json", "spec.json", "direction.json", "direction.ready", "published") if (d / x).exists()]
   171	        print(f"ch{n:02d}", " ".join(st) or "-")
