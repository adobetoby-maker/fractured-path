   145	        errs.append(f"word-lock FAIL at token {k}: src {A[k:k+6]} vs seg {B[k:k+6]} (src {len(A)}, seg {len(B)})")
   146	    if any(len(s["text"]) > LIM for s in tr):
   147	        errs.append("segment over 700 chars")
   148	    if any("*" in s["text"] for s in tr):
   149	        errs.append("asterisk in a segment")
   150	    if not all(any(s["instruct"].startswith(v) for v in PACE.values()) for s in tr):
   151	        errs.append("instruct without a pace cue")
   152	    long = [s["id"] for s in tr if len(s["instruct"].split()) > 32]
   153	    if long:
   154	        errs.append(f"instruct over 32 words: {long[:5]}")
   155	    nb = sum(1 for b in blocks(src) if b == "---")
   156	    if nb != sum(1 for s in tr if s["pauseAfterMs"] == 1500):
   157	        errs.append("scene-break pause count mismatch")
   158	    ready = d / "direction.ready"
   159	    if errs:
   160	        ready.unlink(missing_ok=True)
   161	        print(f"{d.name}: FAIL\n  " + "\n  ".join(errs)); sys.exit(1)
   162	    ready.write_text(f"words {len(A)} segments {len(tr)}\n")
   163	    mins = len(A) / 130
   164	    print(f"{d.name}: PASS words {len(A)} segments {len(tr)} ~{mins:.0f} min speech")
