     1	#!/usr/bin/env python3
     2	"""Fractured Path (Monroe 1.3 edition) -> Breeze direction tracks.
     3	
     4	Same conventions as the Meridian run (meridian-run/*/build.py, verify.py): one segment per paragraph
     5	(split at sentences over 700 chars), per-segment instruct starting with a pace cue, directed pauses
     6	(330 cut-in, 450 breath, 600 thought, 850 reset, 1200 landing/chapter end, 1500 scene break).
     7	
     8	usage:
     9	  fpaudio.py segment BOOK CH        -> RUN/<BOOK>-chNN/raw_segs.json (+ chapter.md snapshot)
    10	  fpaudio.py build   BOOK CH        -> direction.json from spec.json (written by the director)
    11	  fpaudio.py verify  BOOK CH        -> word-lock and format checks; writes direction.ready on pass
    12	  fpaudio.py status  BOOK           -> per-chapter state
    13	The director (an LLM seat) writes RUN/<BOOK>-chNN/spec.json:
    14	  {"summary": "...", "speakers": {"Lira": "same narrator, ... for Lira; ..."},
    15	   "assign": {"s012": "Lira", ...},                 # unlisted segments are the narrator
    16	   "over":   {"s001": ["SLOW", "base narrator, ..."], ...},   # pace tier + colour, overrides the speaker base
    17	   "pause":  {"s014": 850, ...}, "cut": ["s051"], "note": {"s003": "..."}}
    18	"""
    19	import json, math, re, sys
    20	from pathlib import Path
    21	
    22	ED = Path(__file__).resolve().parents[1]
    23	RUN = Path("/Users/drive/.local/share/monroe-tts/fractured-run")
    24	PACE = {"SLOW": "Slow, about 120 words per minute, ", "BASE": "Unhurried, about 130 words per minute, ",
    25	        "EASY": "Easy, about 140 words per minute, "}
    26	NARRATOR = "base narrator: low and restrained; plain, close and understated."
    27	LIM = 700
    28	
    29	
    30	def chdir(book, ch):
    31	    return RUN / f"{book}-ch{int(ch):02d}"
    32	
    33	
    34	def source(book, ch):
    35	    return ED / book / "manuscript" / f"chapter-{int(ch):02d}.md"
    36	
    37	
    38	def blocks(raw):
    39	    """Paragraph blocks with headings removed, code fences flattened, '*' stripped. '---' kept as marker."""
    40	    raw = re.sub(r"^```[^\n]*\n(.*?)^```\s*$", lambda m: "\n".join(
    41	        l.strip().rstrip(".") + "." for l in m.group(1).splitlines() if l.strip()) + "\n",
    42	        raw, flags=re.S | re.M)
    43	    out = []
    44	    for b in re.split(r"\n\s*\n", raw):
    45	        b = b.strip()
    46	        if not b or b.startswith("#"):
    47	            continue
    48	        out.append("---" if b == "---" else " ".join(b.replace("*", "").split()))
    49	    return out
    50	
    51	
    52	def tokens(text):
    53	    return text.split()
    54	
    55	
    56	def split_long(t):
    57	    if len(t) <= LIM:
    58	        return [t]
    59	    parts = re.split(r'(?<=[.!?…])\s+|(?<=[.!?…]["”’])\s+', t)
    60	    target = len(t) / math.ceil(len(t) / LIM)
    61	    out, cur = [], ""
    62	    for p in parts:
    63	        if cur and (len(cur) + 1 + len(p) > LIM or len(cur) >= target):
    64	            out.append(cur); cur = p
    65	        else:
    66	            cur = f"{cur} {p}" if cur else p
    67	    if cur:
    68	        out.append(cur)
    69	    return out
    70	
    71	
    72	def segment(book, ch):
    73	    src = source(book, ch).read_text()
    74	    d = chdir(book, ch); d.mkdir(parents=True, exist_ok=True)
    75	    (d / "chapter.md").write_text(src)
    76	    segs = []
    77	    for b in blocks(src):
    78	        if b == "---":
    79	            segs[-1]["brk"] = True
    80	            continue
    81	        for piece in split_long(b):
    82	            segs.append({"text": piece, "brk": False})
    83	    for i, s in enumerate(segs):
    84	        s["id"] = f"s{i + 1:03d}"
    85	    (d / "raw_segs.json").write_text(json.dumps(segs, indent=1, ensure_ascii=False))
    86	    title = re.match(r"#\s*(.+)", src.splitlines()[0]).group(1).strip()
    87	    print(f"{d.name}: {len(segs)} segments, max {max(len(s['text']) for s in segs)} chars, title {title!r}")
    88	
    89	
    90	def build(book, ch):
    91	    d = chdir(book, ch)
    92	    segs = json.loads((d / "raw_segs.json").read_text())
    93	    spec = json.loads((d / "spec.json").read_text())
    94	    spk, assign, over = spec.get("speakers", {}), spec.get("assign", {}), spec.get("over", {})
    95	    pause, cut, note = spec.get("pause", {}), set(spec.get("cut", [])), spec.get("note", {})
    96	    ids = {s["id"] for s in segs}
    97	    bad = [k for k in list(assign) + list(over) + list(pause) + list(cut) + list(note) if k not in ids]
    98	    if bad:
    99	        sys.exit(f"spec names unknown segment ids: {bad[:10]}")
   100	    missing = sorted({v for v in assign.values() if v not in spk})
   101	    if missing:
   102	        sys.exit(f"assign uses speakers with no base colour: {missing}")
