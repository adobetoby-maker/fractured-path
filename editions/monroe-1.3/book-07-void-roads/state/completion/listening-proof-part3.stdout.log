for my "'$f (@ARGV) {
  open my $fh, "<", $f or die "$f: $!"; local $/; my $s=<$fh>;
  my ($title) = $s =~ /''^#'"\\s+(.+)"'$/m;
  $s =~ s/''^#[''^'"\\n]*\\n+//;
  my @sc = split(/\\n\\n---\\n\\n/, "'$s);
  print "$f'"\\nTITLE: "'$title'"\\nSCENES: \".scalar(@sc).\"\\n\";
  for my "'$i (0..$#sc) {
    $sc[$i] =~ s/''^'"\\s+|\\s+"'$//g;
    my @w = split(/'"\\s+/, "'$sc[$i]);
    my $first = join(" ", @w[0..5]);
    my $last = join(" ", @w[$#w-5..$#w]);
    print "S".($i+1)." FIRST: $first'"\\nS\".("'$i+1)." LAST: $last'"\\n\";
  }
  print \"\\n\";
}
