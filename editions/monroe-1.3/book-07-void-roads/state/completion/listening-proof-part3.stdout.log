90-def build(book, ch):
91-    d = chdir(book, ch)
92-    segs = json.loads((d / "raw_segs.json").read_text())
93-    spec = json.loads((d / "spec.json").read_text())
94-    spk, assign, over = spec.get("speakers", {}), spec.get("assign", {}), spec.get("over", {})
95-    pause, cut, note = spec.get("pause", {}), set(spec.get("cut", [])), spec.get("note", {})
96-    ids = {s["id"] for s in segs}
97-    bad = [k for k in list(assign) + list(over) + list(pause) + list(cut) + list(note) if k not in ids]
98-    if bad:
99:        sys.exit(f"spec names unknown segment ids: {bad[:10]}")
100-    missing = sorted({v for v in assign.values() if v not in spk})
101-    if missing:
102-        sys.exit(f"assign uses speakers with no base colour: {missing}")
103-    title = re.match(r"#\s*(.+)", (d / "chapter.md").read_text().splitlines()[0]).group(1).strip()
104-    out = []
105-    for i, s in enumerate(segs):
106-        sid, who = s["id"], assign.get(s["id"], "narrator")
107-        if sid in over:
108-            tier, colour = over[sid]
109-        else:
110-            tier, colour = "BASE", (spk[who] if who != "narrator" else NARRATOR)
111-        if tier not in PACE:
112-            sys.exit(f"{sid}: unknown pace tier {tier}")
113-        if s["brk"]:
114-            p = 1500
115-        elif i == len(segs) - 1:
116-            p = 1200
117-        elif sid in cut:
118-            p = 330
119-        else:
120-            p = int(pause.get(sid, 600))
121-        seg = {"id": sid, "speaker": who, "text": s["text"], "instruct": PACE[tier] + colour, "pauseAfterMs": p}
122-        if sid in note:
123-            seg["note"] = note[sid]
124-        out.append(seg)
125-    track = {"chapter": f"{book}/chapter-{int(ch):02d}", "title": title, "engine": "Breeze TTS 2 (MLX)",
126-             "narrator": "Calder", "coach": "CALDER_DELIVERY_COACH_V1", "edition": "monroe-1.3",
127-             "lexiconStatus": "apply only owner-confirmed render substitutions",
128:             "summary": spec.get("summary", ""), "segments": out}
129-    (d / "direction.json").write_text(json.dumps(track, indent=1, ensure_ascii=False))
130:    print(f"{d.name}: direction.json {len(out)} segments, {sum(1 for x in out if x['speaker'] != 'narrator')} voiced")
