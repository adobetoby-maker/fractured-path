from pathlib import Path
import re
root=Path('editions/monroe-1.3/book-07-void-roads/manuscript')
files=sorted(root.glob('chapter-*.md'))
checks={k:[] for k in ['odd_quote','odd_asterisk','curly','bad_break','headings','underscore','backtick','slash','digit','bracket','abbr','double_word','lower_para','suspect_end','trailing','double_space','tabs','allcaps']}
long=[]; stats=[]
