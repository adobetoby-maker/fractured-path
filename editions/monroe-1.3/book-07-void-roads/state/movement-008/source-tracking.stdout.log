import re,difflib
from pathlib import Path
TOK=re.compile(r\"[a-z0-9]+(?:['’][a-z0-9]+)*\")
SPLIT=re.compile(r\"(?<=[."'!?…])['"\\\"'”’*)]*\\s+\")
def toks(s): return TOK.findall(s.lower().replace('’',\"'\"))
def sents(path):
 out=[]
 for n,line in enumerate(Path(path).read_text().splitlines(),1):
  z=line.strip()
  if not z or z.startswith('#') or z=='---': continue
  for s in SPLIT.split(z):
   t=toks(s)
   if len(t)>=8: out.append((n,s,t))
 return out
