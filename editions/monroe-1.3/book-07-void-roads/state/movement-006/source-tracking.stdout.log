| 31 | 0 | 0 | 0 | 0 | 1 | — | — | **1** |
| 32 | 0 | 1 | 0 | 1 | 0 | — | — | **2** |
| 33 | 0 | 1 | 0 | 0 | 0 | — | — | **1** |
| 34 | 0 | 0 | 3 | 0 | 0 | — | — | **3** |
| 35 | 0 | 0 | 0 | 0 | 0 | 1 | 0 | **1** |
| 36 | 1 | 0 | 0 | 0 | 0 | — | — | **1** |
