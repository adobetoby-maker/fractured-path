from pathlib import Path
import re
from difflib import SequenceMatcher
srcp=Path('books/book-08-before-the-paths/chapters/chapter-01.md')
msps=[Path(f'editions/monroe-1.3/book-08-before-the-paths/manuscript/chapter-{i:02d}.md') for i in range(1,7)]
def sents(p):
    out=[]
    for ln,line in enumerate(p.read_text().splitlines(),1):
        if not line.strip() or line.startswith('#') or line.strip()=='---': continue
        # paragraph-line units plus sentence-ish splits
        for s in re.split(r'(?<=[."'!?])(?:["*])?'"\\s+(?=[A-Z\"*\\[])',line.strip()):
            s=s.strip()
            if len(re.findall(r\"[A-Za-z]+\",s))>=5: out.append((ln,s))
    return out
src=sents(srcp)
for p in msps:
    ms=sents(p)
    pairs=[]
    for ml,m in ms:
      mn=' '.join(re.findall(r\"[a-z]+\",m.lower()))
      for sl,s in src:
        sn=' '.join(re.findall(r\"[a-z]+\",s.lower()))
        ratio=SequenceMatcher(None,mn,sn).ratio()
        # word-set jaccard weighted content length
        a=set(mn.split()); b=set(sn.split()); jac=len(a&b)/max(1,len(a|b))
        score=.65*ratio+.35*jac
        if score>.27: pairs.append((score,ml,m,sl,s))
    pairs.sort(reverse=True)
    print('\\n###',p.name)
    for score,ml,m,sl,s in pairs[:30]:
      print(f'{score:.3f} MS {ml}: {m[:190]}')
      print(f'      SRC {sl}: {s[:190]}')
