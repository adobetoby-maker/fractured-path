/bin/zsh -lc "rg -n \"six rows|six years|abstract|first sheet|Fallow's|Ring's|sixty-one|ninety-four|hundred and thirty-eight|two hundred and six|series\" editions/monroe-1.3/book-08-before-the-paths/manuscript/chapter-{13..26}.md" in /Users/drive/fractured-path-monroe13
