/bin/zsh -lc "audit='editions/monroe-1.3/book-08-before-the-paths/state/movement-007/plan-audit.md'
base='editions/monroe-1.3/book-08-before-the-paths'
awk '
/"'^[0-9]+'"\\. "'`manuscript'"\\/chapter-[0-9][0-9]\\.md"'`$/ { p=$0; sub(/''^[0-9]+'"\\. "'`/,"",p); sub(/`$/, "", p); next }
/''^   old: `/ { s=$0; sub(/''^   old: `/,"",s); sub(/`$/, "",s); print p "'"\\t\" s }
' \""'$audit" | while IFS=$'"'\\t' read -r p s; do
  n="'$(grep -Fxc -- "$s" "$base/$p")
  if [[ "$n" != 1 ]]; then printf '"'FAIL %s %s\\n%s\\n' \""'$n" "$p" "$s"; fi
done
printf '"'old='; rg -c '"'^   old: `'"' \""'$audit"
printf '"'new='; rg -c '"'^   new: `'"' \""'$audit"
printf '"'heads='; rg -c '"'^[0-9]+'"\\. "'`manuscript/chapter-[0-9][0-9]'"\\.md"'`$'"' \""'$audit"
rg -n '"'Apply fix|fixes [0-9]' \""'$audit" | head -n 50' in /Users/drive/fractured-path-monroe13
