/bin/zsh -lc "rg -n 'Deployment|deployment|thirty-one|thirty-two|Thirty-one|Thirty-two' editions/monroe-1.3/book-08-before-the-paths/BOOK_MAP.md editions/monroe-1.3/book-08-before-the-paths/STATE_LEDGER.md editions/monroe-1.3/book-08-before-the-paths/packets/MOVEMENT-00{3,4,5,6,7,8,9}.md" in /Users/drive/fractured-path-monroe13
