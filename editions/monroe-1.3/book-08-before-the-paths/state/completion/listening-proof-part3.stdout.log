from pathlib import Path
import re
base=Path('editions/monroe-1.3/book-08-before-the-paths/manuscript')
for n in range(31,46):
 p=base/f'chapter-{n:02}.md'; raw=p.read_text(); lines=raw.splitlines()
 odd=[]
 for i,line in enumerate(lines,1):
  if line.count('\"')%2: odd.append((i,line.count('\"'),line[:90]))
 digits=[(i,re.findall(r'(?<"'![A-Za-z])'"\\d+(?:st|nd|rd|th)?',line)) for i,line in enumerate(lines,1) if re.search(r'(?<"'![A-Za-z])'"\\d',line) and not line.startswith('#')]
 stars=[(i,line.count('*')) for i,line in enumerate(lines,1) if line.count('*')%2]
 breaks=[]
 for i,line in enumerate(lines):
  if line=='---' and (i==0 or i+1>=len(lines) or lines[i-1]"'!='"'' or lines[i+1]"'!='"''): breaks.append(i+1)
 scars=[(i+1,line) for i,line in enumerate(lines) if re.search(r'\\.\\\"\\s+\\\"',line)]
 longs=[]
 for i,line in enumerate(lines,1):
  if not line or line.startswith('#') or line=='---': continue
  flat=' '.join(line.replace('*','').split())
  if len(flat)>700: longs.append((i,len(flat),flat[:70]))
 print(f'ch{n:02}: odd_quotes={odd or \"none\"}; digits={digits or \"none\"}; odd_stars={stars or \"none\"}; bad_breaks={breaks or \"none\"}; scar={scars or \"none\"}; long={longs or \"none\"}')
