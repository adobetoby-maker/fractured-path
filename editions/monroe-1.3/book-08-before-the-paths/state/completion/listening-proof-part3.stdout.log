  if chapter && line =~ /"'^'"\\d+\\. "'`([''^`]*)` … `([''^`]*)` —/
    (recorded[chapter] ||= []) << [$1, $2]
  end
  chapter = nil if line.start_with?('"'## Lane joins')
end
errors = []
total = 0
(31..45).each do |n|
  text = File.read(\"#{base}/manuscript/chapter-#{n}.md\").sub(/\\A#.*?\\n\\n/m, '')
  scenes = text.split(/\\n\\n---\\n\\n/)
  actual = scenes.map { |s| w = s.split(/\\s+/); [w.first(6).join(' '), w.last(6).join(' ')] }
  total += scenes.length
  errors << \"chapter #{n}: notes #{recorded.fetch(n, []).length}, source #{scenes.length}\" unless recorded.fetch(n, []).length == scenes.length
  actual.each_with_index { |pair, i| errors << \"chapter #{n} scene #{i + 1}\" if recorded[n] && recorded[n][i] "'!= pair }
end
puts "chapters=15 scenes=#{total} boundary_mismatches=#{errors.length}"
puts errors
