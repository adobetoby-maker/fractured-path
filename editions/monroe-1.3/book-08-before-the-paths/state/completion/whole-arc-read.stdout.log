/bin/zsh -lc "rg -n -i \"hundred and (thirty|sixty|seventy|eighty|ninety|three hundred)|\\b(270th|277th|279th|280th|281st|282nd|283rd|284th|285th|286th|287th|288th|289th|290th|291st|292nd|293rd|294th|295th|296th|297th|298th|299th|300th|301st|302nd|303rd|304th|305th|306th|307th|308th)\\b|day past the Line|days past the Line\" editions/monroe-1.3/book-08-before-the-paths/manuscript/chapter-*.md" in /Users/drive/fractured-path-monroe13
