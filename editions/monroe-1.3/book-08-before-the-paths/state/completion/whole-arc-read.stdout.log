/bin/zsh -lc 'rg -n -i "deployment since the Line|deployment:|Thirty-(two|three|four|five)|thirty (two|three|four|five)|not counted|self-read|turned the Rune|thirteenth|eleventh|twelfth" editions/monroe-1.3/book-08-before-the-paths/manuscript/chapter-*.md' in /Users/drive/fractured-path-monroe13
