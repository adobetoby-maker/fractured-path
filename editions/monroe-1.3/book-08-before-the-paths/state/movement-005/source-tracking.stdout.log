import re,difflib
from pathlib import Path
TOK=re.compile(r\"[a-z0-9]+(?:['’][a-z0-9]+)*\")
SPLIT=re.compile(r\"(?<=[."'!?…])['"\\\"'”’*)]*\\s+\")
def toks(s): return TOK.findall(s.lower().replace('’',\"'\"))
def lsents(path):
 out=[]
 for n,line in enumerate(Path(path).read_text().splitlines(),1):
  if line.startswith('#') or line.strip()=='---': continue
  for s in SPLIT.split(line.strip()):
   t=toks(s)
   if len(t)>=8: out.append((n,s,t,set(t)))
 return out
src=[]
for c in (10,11,12):
 p=f'books/book-08-before-the-paths/chapters/chapter-{c:02d}.md'
 for row in lsents(p): src.append((p,*row))
for c in range(27,34):
 p=f'editions/monroe-1.3/book-08-before-the-paths/manuscript/chapter-{c:02d}.md'
 rows=[]
 for ln,s,t,ts in lsents(p):
  best=[]
  for sp,sln,ss,st,sts in src:
   j=len(ts&sts)/len(ts|sts)
   if j<.12: continue
   rat=difflib.SequenceMatcher(None,t,st,autojunk=False).ratio()
   if rat>=.38: best.append((rat,sp,sln,ss))
  if best:
   rat,sp,sln,ss=max(best)
   rows.append((rat,ln,s,sp,sln,ss))
 print(f'## chapter {c}')
 for rat,ln,s,sp,sln,ss in sorted(rows, reverse=True):
  print(f'{rat:.2f} MS {ln}: {s}')
  print(f'     SRC {Path(sp).name}:{sln}: {ss}')
