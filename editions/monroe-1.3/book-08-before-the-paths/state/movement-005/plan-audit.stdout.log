/bin/zsh -lc "rg -n -e 'two hundred and eighty-(fourth|fifth|sixth|seventh|eighth|ninth|ninetieth)' -e 'day of thirty' -e 'day out of the wool' -e 'days left' -e 'A hundred and thirty-(six|four)' -e 'Deployment since the Line' -e 'Eleven' -e 'fourteen letters' -e 'seven.*twenty-three.*eleven' -e 'three days left' -e 'paid through' -e 'two marks' editions/monroe-1.3/book-08-before-the-paths/manuscript/chapter-{27,28,29,30,31,32,33}.md" in /Users/drive/fractured-path-monroe13
